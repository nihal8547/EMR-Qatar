# Copy to .env, then: docker compose up -d --build   (production: see deploy/ and README "Going live")
# Generate secrets with:  openssl rand -base64 48
JWT_SECRET=replace-with-48+-random-characters
DATA_ENCRYPTION_KEY=replace-with-another-48+-random-characters
DB_PASSWORD=replace-with-a-strong-db-password
APP_PORT=4000
# false = masters and roles only (use for a real centre); true = sample patients/visits for demos
DEMO_DATA=false
# Production behind Caddy/nginx:
# TRUST_PROXY=1
# PUBLIC_BASE_URL=https://hms.yourcentre.qa
# MFA_REQUIRED_ROLES=Super Admin,Accountant
# WhatsApp (n8n): N8N_WEBHOOK_SECRET=openssl rand -hex 24
# Optional tuning: SESSION_HOURS=8  SESSION_IDLE_MIN=60  RATE_LIMIT_PER_MIN=600
